# Порт публикации на хосте (контейнер слушает 8000)
DIARIZE_PORT=8124

# Ключи доступа (Authorization: Bearer <key> или X-API-Key), через запятую.
# ПУСТО = аутентификация отключена.
DIARIZE_API_KEYS=change-me-key-1

# HF-токен с ПРИНЯТОЙ лицензией pyannote/speaker-diarization-community-1
# (обязателен для диаризации моно-аудио). Принять: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Модель диаризации (pyannote, gated)
DIAR_MODEL=pyannote/speaker-diarization-community-1

# ── ASR: где считаем ────────────────────────────────────────────────────────
# local — модели onnx-asr на нашей карте, mws — облако MWS.
# Провайдер и модель выбираются в интерфейсе; здесь — что предвыбрано.
ASR_PROVIDER_DEFAULT=local

# Локальные модели (onnx-asr скачает при первом обращении в том /models).
# Грузятся ЛЕНИВО: пока в интерфейсе не выбран local, видеопамять не занимается.
DIARIZE_DEFAULT_MODEL=gigaam
GIGAAM_MODEL=gigaam-v3-e2e-rnnt
PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3

# Выгрузка локальных моделей после простоя, сек (0 — не выгружать).
# Кнопка «Выгрузить модели» в интерфейсе делает это немедленно.
LOCAL_IDLE_UNLOAD_S=900

# Облачный ASR MWS (OpenAI-совместимый). Пусто = провайдер скрыт в интерфейсе.
MWS_BASE_URL=https://gpt.mwsapis.ru/projects/<project>/openai/v1
MWS_API_KEY=
MWS_MODELS=gigaam-v3,whisper-large-v3
MWS_DEFAULT_MODEL=gigaam-v3
MWS_TIMEOUT=600
# Лимит загрузки в облако, МБ. Перед отправкой аудио жмётся в моно-mp3 32 кбит/с
# (примерно 14 МБ на час записи), но многочасовые файлы всё равно не пройдут.
MWS_MAX_UPLOAD_MB=24

# Сколько реплик шлём в облако параллельно, когда нужны спикеры
# (аудио режется по turn'ам pyannote, каждый кусок — отдельный запрос).
REMOTE_CONCURRENCY=8

# Лимит размера загрузки (байт), по умолчанию 1 GiB
MAX_UPLOAD_BYTES=1073741824

# LLM для постобработки (summary/follow_up/todo). На сервере — внутренний адрес vLLM.
LLM_BASE_URL=http://gpt-oss-120b:8000/v1
LLM_API_KEY=dummy-key
LLM_MODEL=gpt-oss-120b
LLM_TIMEOUT=120

# Логин для веб-интерфейса (если все три заданы — включается форма /login).
# AUTH_PASSWORD_HASH = sha256(пароль) в hex. AUTH_SECRET — случайная строка для подписи cookie.
AUTH_USERNAME=user01
AUTH_PASSWORD_HASH=
AUTH_SECRET=
AUTH_SESSION_TTL=604800
